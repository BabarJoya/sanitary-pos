VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ---- Server-only secrets (scripts like cron-notifications.js / superadmin/migrate.mjs) ----
# NEVER prefix these with VITE_ — Vite copies VITE_* values into the public browser bundle.
# Put real values only in your local .env (git-ignored) or the hosting provider's secret settings.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
